# Copy to .env and fill in. Free key at https://carto.com/basemaps/apikey
EXPO_PUBLIC_CARTO_KEY=
# Free Groq key at https://console.groq.com/keys (AI ranking; optional)
EXPO_PUBLIC_GROQ_KEY=
# Free Geoapify key at https://www.geoapify.com (second hospital source; optional)
EXPO_PUBLIC_GEOAPIFY_KEY=
# Optional model override if the default retires
# EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-20b
